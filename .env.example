# SocialScaleBooster — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Database (Neon / PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# PGHOST=
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# ── Auth / Signing ───────────────────────────────────────
JWT_SECRET=generate-with-openssl-rand-hex-32
SESSION_SECRET=generate-with-openssl-rand-hex-32
SFS_JWT_SECRET=generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
ADMIN_SECRET=generate-with-openssl-rand-hex-32

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# ── OpenAI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── Social OAuth (Meta / Facebook) ───────────────────────
META_APP_ID=
META_APP_SECRET=

# ── SFS Ecosystem ────────────────────────────────────────
SFS_BACKEND_URL=https://your-sfs-backend.replit.app
